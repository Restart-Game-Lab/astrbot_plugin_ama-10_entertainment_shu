# 统一行尾序列：仓库内所有文本文件一律使用 LF (Unix 行尾)

# 自动检测文本文件并进行 LF 规范化
* text=auto

# 显式声明文本文件，始终规范化并转为 LF
*.py    text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.cfg   text eol=lf
*.sh    text eol=lf
*.ps1   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf

# 二进制文件（禁止行尾转换）
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.bmp  binary
*.exe  binary
*.dll  binary
*.zip  binary
*.tar  binary
*.gz   binary
*.deb  binary
*.pyc  binary
